<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <Color x:Key="SystemAccentColor">#6D5BB5</Color>
    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush">#6D5BB5</SolidColorBrush>
  </Styles.Resources>
  <Style Selector="Window">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="Foreground" Value="#202126" />
    <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic, sans-serif" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock.secondary"><Setter Property="Foreground" Value="#6B6D78" /><Setter Property="FontSize" Value="13" /></Style>
  <Style Selector="TextBlock.caption"><Setter Property="Foreground" Value="#6B6D78" /><Setter Property="FontSize" Value="12" /></Style>
  <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="24" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.error"><Setter Property="Foreground" Value="#B5444D" /></Style>
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="36" /><Setter Property="Padding" Value="14,8" />
    <Setter Property="CornerRadius" Value="12" /><Setter Property="Background" Value="#F7F7FA" />
    <Setter Property="BorderBrush" Value="#E8E8ED" /><Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.primary"><Setter Property="Background" Value="#6D5BB5" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="#6D5BB5" /></Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#6350A9" /><Setter Property="Foreground" Value="White" /></Style>
  <Style Selector="Button.soft"><Setter Property="Background" Value="#F0ECFA" /><Setter Property="Foreground" Value="#6D5BB5" /><Setter Property="BorderThickness" Value="0" /></Style>
  <Style Selector="Button.quiet"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
  <Style Selector="Button.danger"><Setter Property="Background" Value="#FBEFF0" /><Setter Property="Foreground" Value="#B5444D" /><Setter Property="BorderBrush" Value="#FBEFF0" /></Style>
  <Style Selector="TextBox"><Setter Property="CornerRadius" Value="10" /><Setter Property="BorderBrush" Value="#E8E8ED" /><Setter Property="MinHeight" Value="38" /><Setter Property="Padding" Value="12,8" /></Style>
  <Style Selector="TextBox.search"><Setter Property="Background" Value="#F7F7FA" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="12" /></Style>
  <Style Selector="TextBox.title"><Setter Property="FontSize" Value="26" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="0,6" /></Style>
  <Style Selector="TextBox.reading"><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="FontSize" Value="15" /><Setter Property="Padding" Value="0,16" /></Style>
  <Style Selector="ComboBox">
    <Style.Resources>
      <SolidColorBrush x:Key="ComboBoxDropDownBackground">#FFFFFF</SolidColorBrush>
      <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush">#E8E8ED</SolidColorBrush>
      <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
      <Thickness x:Key="ComboBoxDropdownBorderPadding">6</Thickness>
    </Style.Resources>
    <Setter Property="CornerRadius" Value="10" /><Setter Property="MinHeight" Value="38" /><Setter Property="BorderBrush" Value="#E8E8ED" /></Style>
  <Style Selector="ListBox"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" /></Style>
  <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="12,10" /><Setter Property="CornerRadius" Value="9" /></Style>
  <Style Selector="ListBox.navigation ListBoxItem"><Setter Property="MinHeight" Value="42" /><Setter Property="Margin" Value="8,2" /></Style>
  <Style Selector="ListBox.recordings ListBoxItem"><Setter Property="MinHeight" Value="100" /><Setter Property="Padding" Value="20,16" /><Setter Property="CornerRadius" Value="0" /><Setter Property="Margin" Value="0" /></Style>
  <Style Selector="ListBoxItem:selected"><Setter Property="Background" Value="#F0ECFA" /><Setter Property="Foreground" Value="#6D5BB5" /></Style>
  <Style Selector="TextBlock.selection-check"><Setter Property="Opacity" Value="0" /></Style>
  <Style Selector="ListBoxItem:selected TextBlock.selection-check"><Setter Property="Opacity" Value="1" /></Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="#F0ECFA" /><Setter Property="BorderThickness" Value="0" /></Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#F7F7FA" /></Style>
  <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#F0ECFA" /></Style>
  <Style Selector="ListBoxItem.drop-target /template/ ContentPresenter"><Setter Property="Background" Value="#E5DFF4" /><Setter Property="BorderBrush" Value="#6D5BB5" /><Setter Property="BorderThickness" Value="2" /></Style>
  <Style Selector="Grid.drop-target"><Setter Property="Background" Value="#F0ECFA" /></Style>
  <Style Selector="TabControl"><Setter Property="Padding" Value="0" /></Style>
  <Style Selector="TabItem"><Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="20,10" /></Style>
  <Style Selector="TabItem:selected"><Setter Property="Foreground" Value="#6D5BB5" /></Style>
  <Style Selector="TabControl.result-tabs">
    <Setter Property="Template"><ControlTemplate><Grid RowDefinitions="Auto,*">
      <Border Background="#F7F7FA" CornerRadius="11" Padding="4" Height="42" Margin="32,0,32,0" HorizontalAlignment="Left">
        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
      </Border>
      <ContentPresenter Name="PART_SelectedContentHost" Grid.Row="1" Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding SelectedContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid></ControlTemplate></Setter>
    <Setter Property="ItemsPanel"><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></Setter>
  </Style>
  <Style Selector="TabControl.result-tabs TabItem">
    <Setter Property="Margin" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="0" /><Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="19,9" /><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="#6B6D78" />
    <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" /></Border></ControlTemplate></Setter>
  </Style>
  <Style Selector="TabControl.result-tabs TabItem:selected"><Setter Property="Background" Value="#F0ECFA" /><Setter Property="Foreground" Value="#6D5BB5" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TabControl.result-tabs TabItem:focus-visible"><Setter Property="Background" Value="#E5DFF4" /></Style>
  <Style Selector="TextBox.title"><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="39" /><Setter Property="Height" Value="39" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <!-- Shared popup surfaces cover toolbar flyouts, right-click menus and submenus. -->
  <Style Selector="MenuFlyoutPresenter, ContextMenu, FlyoutPresenter">
    <Setter Property="Background" Value="#FFFFFF" /><Setter Property="Foreground" Value="#202126" />
    <Setter Property="BorderBrush" Value="#E8E8ED" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="6" />
    <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic, sans-serif" /><Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="MenuItem"><Setter Property="Padding" Value="12,9" /><Setter Property="MinHeight" Value="38" /><Setter Property="CornerRadius" Value="8" /></Style>
  <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot, MenuItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="#F0ECFA" /><Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="MenuItem:pointerover, MenuItem:selected"><Setter Property="Foreground" Value="#6D5BB5" /></Style>
  <Style Selector="MenuItem.danger:pointerover /template/ Border#PART_LayoutRoot, MenuItem.danger:selected /template/ Border#PART_LayoutRoot"><Setter Property="Background" Value="#FBEFF0" /></Style>
  <Style Selector="MenuItem.danger:pointerover, MenuItem.danger:selected"><Setter Property="Foreground" Value="#B5444D" /></Style>
  <Style Selector="MenuItem:disabled"><Setter Property="Opacity" Value="0.5" /></Style>
  <Style Selector="MenuFlyoutPresenter Separator, ContextMenu Separator"><Setter Property="Background" Value="#E8E8ED" /><Setter Property="Margin" Value="6,5" /></Style>
  <Style Selector="ComboBoxItem"><Setter Property="Padding" Value="12,9" /><Setter Property="MinHeight" Value="38" /><Setter Property="CornerRadius" Value="8" /></Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter, ComboBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#F0ECFA" /><Setter Property="Foreground" Value="#6D5BB5" /></Style>
  <Style Selector="ToolTip"><Setter Property="Background" Value="#202126" /><Setter Property="Foreground" Value="White" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="10,6" /></Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#F0ECFA" /><Setter Property="BorderBrush" Value="#E8E8ED" /><Setter Property="Foreground" Value="#6D5BB5" /></Style>
  <Style Selector="Button:pressed /template/ ContentPresenter"><Setter Property="Background" Value="#E5DFF4" /><Setter Property="Foreground" Value="#6D5BB5" /></Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter, Button.primary:pressed /template/ ContentPresenter"><Setter Property="Background" Value="#6350A9" /><Setter Property="BorderBrush" Value="#6350A9" /><Setter Property="Foreground" Value="White" /></Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter, Button.danger:pressed /template/ ContentPresenter"><Setter Property="Background" Value="#FBEFF0" /><Setter Property="Foreground" Value="#B5444D" /></Style>
  <Style Selector="MenuItem.danger"><Setter Property="Foreground" Value="#B5444D" /></Style>
  <Style Selector="Button:focus-visible"><Setter Property="BorderBrush" Value="#6D5BB5" /><Setter Property="BorderThickness" Value="2" /></Style>
  <Style Selector="ListBoxItem:focus-visible /template/ ContentPresenter"><Setter Property="BorderBrush" Value="#6D5BB5" /><Setter Property="BorderThickness" Value="1" /></Style>
  <Style Selector="TextBox:focus"><Setter Property="BorderBrush" Value="#6D5BB5" /><Setter Property="BorderThickness" Value="1" /></Style>
  <Style Selector=".settings-view Border.settings-group"><Setter Property="BorderBrush" Value="#E8E8ED" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Background" Value="White" /><Setter Property="ClipToBounds" Value="True" /></Style>
  <Style Selector=".settings-view Grid.settings-row"><Setter Property="Margin" Value="14,0" /></Style>
  <Style Selector=".settings-view StackPanel.settings-field"><Setter Property="Margin" Value="14,12" /></Style>
  <Style Selector=".settings-view TextBox.settings-path"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0,4" /><Setter Property="MinHeight" Value="28" /><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="#6B6D78" /></Style>
  <Style Selector=".settings-view Expander.settings-advanced"><Setter Property="BorderThickness" Value="0" /><Setter Property="Margin" Value="0,4" /></Style>
  <Style Selector=".settings-view Button.quiet"><Setter Property="Foreground" Value="#6B6D78" /><Setter Property="Padding" Value="10,6" /></Style>
  <Style Selector=".settings-view Button.compact"><Setter Property="Padding" Value="10,6" /><Setter Property="MinHeight" Value="32" /><Setter Property="FontSize" Value="13" /></Style>
  <Style Selector=".settings-view Button:disabled"><Setter Property="Background" Value="#F7F7FA" /><Setter Property="Foreground" Value="#6B6D78" /><Setter Property="BorderBrush" Value="#E8E8ED" /><Setter Property="Opacity" Value="0.6" /></Style>
  <Style Selector=".settings-view Button:disabled /template/ ContentPresenter"><Setter Property="Background" Value="#F7F7FA" /><Setter Property="Foreground" Value="#6B6D78" /><Setter Property="BorderBrush" Value="#E8E8ED" /></Style>
  <Style Selector=".settings-view Expander.settings-advanced"><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="0,8,0,0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
  <Style Selector=".settings-view Expander.settings-advanced /template/ ToggleButton#ExpanderHeader"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="#6B6D78" /><Setter Property="Padding" Value="16,8,0,8" /></Style>
  <Style Selector=".settings-view Expander.settings-advanced /template/ ToggleButton#ExpanderHeader /template/ Border#ToggleButtonBackground"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
  <Style Selector=".settings-view Expander.settings-advanced /template/ Border#ExpanderContent"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
  <Style Selector=".settings-view TextBlock"><Setter Property="FontSize" Value="12" /></Style>
  <Style Selector=".settings-view ComboBox"><Setter Property="FontSize" Value="11" /></Style>
  <Style Selector="Button.icon-action"><Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" /><Setter Property="MinHeight" Value="36" /><Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="10" /></Style>
  <Style Selector="ListBox.navigation ListBoxItem"><Setter Property="FontSize" Value="12" /><Setter Property="MinHeight" Value="40" /></Style>
  <Style Selector="Button:disabled"><Setter Property="Background" Value="#F7F7FA" /><Setter Property="Foreground" Value="#6B6D78" /><Setter Property="BorderBrush" Value="#E8E8ED" /><Setter Property="Opacity" Value="0.6" /></Style>
  <Style Selector="Button:disabled /template/ ContentPresenter"><Setter Property="Background" Value="#F7F7FA" /><Setter Property="Foreground" Value="#6B6D78" /><Setter Property="BorderBrush" Value="#E8E8ED" /></Style>
  <Style Selector="Path.vemo-icon"><Setter Property="Stroke" Value="#6B6D78" /></Style>
  <Style Selector="ListBoxItem:selected Path.vemo-icon, TabItem:selected Path.vemo-icon"><Setter Property="Stroke" Value="#6D5BB5" /></Style>
</Styles>
