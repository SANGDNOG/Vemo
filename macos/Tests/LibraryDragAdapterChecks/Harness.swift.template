// Only the SwiftUI boundary is synthetic; shipping adapters, core, providers and store are real.
@propertyWrapper struct Binding<Value> {
    let get: () -> Value
    let set: (Value) -> Void
    var wrappedValue: Value { get { get() } nonmutating set { set(newValue) } }
}
struct DropInfo {
    let providers: [NSItemProvider]
    func itemProviders(for types: [UTType]) -> [NSItemProvider] {
        providers.filter { provider in types.contains { provider.hasItemConformingToTypeIdentifier($0.identifier) } }
    }
}
enum DropOperation { case move, cancel }
struct DropProposal { let operation: DropOperation }
protocol DropDelegate {}
