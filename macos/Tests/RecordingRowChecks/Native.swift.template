@MainActor final class FixtureModel: ObservableObject {
 @Published var selection: String? = "a"
 let visibleJobs = [Job(id: "a"), Job(id: "b")]
 var loadTriggers = 0
 func libraryDragPayload(kind: LibraryDragKind, id: String) -> LibraryDragPayload {
  LibraryDragPayload(kind:kind,id:id,sessionID:"fixture-session")
 }
